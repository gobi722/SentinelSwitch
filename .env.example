# Copy this file to `.env` and fill in your own local values before running
# `docker compose up`. `.env` is gitignored — never commit real secrets here.

# Postgres superuser password for the local `postgres` container.
POSTGRES_PASSWORD=changeme

# Grafana admin login password for the local `grafana` container.
GF_SECURITY_ADMIN_PASSWORD=changeme

# HMAC key used to hash PANs into card_hash (api-gateway). Any random string
# for local dev; use a securely generated secret in any real deployment.
PAN_HASH_SECRET=changeme

# Key required in the `x-admin-key` header to call AdminService (api-gateway).
ADMIN_API_KEY=changeme

# Rate limiting (api-gateway).
RATE_LIMITING_RPS=5000
RATE_LIMITING_BURST=2000
